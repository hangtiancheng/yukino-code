{
  "name": "@yukino.js/logger",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*.js": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@yukino.js/storage": "workspace:*",
    "@yukino.js/teams": "workspace:*",
    "pino": "^10.4.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@yukino.js/pkg-build": "workspace:*",
    "tsdown": "^0.23.1"
  }
}
