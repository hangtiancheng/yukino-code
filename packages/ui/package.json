{
  "name": "@yukino.js/ui",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*.js": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@yukino.js/agent": "workspace:*",
    "@yukino.js/bootstrap": "workspace:*",
    "@yukino.js/commands": "workspace:*",
    "@yukino.js/compact": "workspace:*",
    "@yukino.js/config": "workspace:*",
    "@yukino.js/conversation": "workspace:*",
    "@yukino.js/feedback": "workspace:*",
    "@yukino.js/file-history": "workspace:*",
    "@yukino.js/goal": "workspace:*",
    "@yukino.js/history": "workspace:*",
    "@yukino.js/hooks": "workspace:*",
    "@yukino.js/images": "workspace:*",
    "@yukino.js/llm": "workspace:*",
    "@yukino.js/logger": "workspace:*",
    "@yukino.js/lsp": "workspace:*",
    "@yukino.js/model-context-protocol": "workspace:*",
    "@yukino.js/memory": "workspace:*",
    "@yukino.js/permissions": "workspace:*",
    "@yukino.js/plan-file": "workspace:*",
    "@yukino.js/prompt": "workspace:*",
    "@yukino.js/sandbox": "workspace:*",
    "@yukino.js/session": "workspace:*",
    "@yukino.js/skills": "workspace:*",
    "@yukino.js/subagent": "workspace:*",
    "@yukino.js/teams": "workspace:*",
    "@yukino.js/theme": "workspace:*",
    "@yukino.js/todo": "workspace:*",
    "@yukino.js/tool-result": "workspace:*",
    "@yukino.js/tools": "workspace:*",
    "@yukino.js/update": "workspace:*",
    "@yukino.js/utils": "workspace:*",
    "@yukino.js/version": "workspace:*",
    "@yukino.js/vscode": "workspace:*",
    "@yukino.js/workflow": "workspace:*",
    "ansi-escapes": "^7.3.0",
    "ansi-regex": "^6.4.0",
    "chalk": "^5.6.2",
    "fuse.js": "^7.5.0",
    "ink": "^7.1.1",
    "marked": "^18.1.1",
    "node-emoji": "^2.2.0",
    "react": "19.2.7",
    "shiki": "^4.5.0",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "supports-hyperlinks": "^4.6.0",
    "wrap-ansi": "^10.0.2"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@yukino.js/build-config": "workspace:*",
    "tsdown": "^0.23.1"
  }
}
