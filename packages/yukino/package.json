{
  "name": "@yukino.js/yukino",
  "version": "0.0.24",
  "description": "Yukino is a terminal-based AI coding agent. It provides an interactive UI (terminal user interface) for conversing with large language models, executing code, manipulating files, and orchestrating multi-agent workflows, all from the command line.",
  "keywords": [
    "a2a",
    "agent",
    "agent-team",
    "ai",
    "anthropic",
    "assistant",
    "automation",
    "chat",
    "chatbot",
    "cli",
    "code-review",
    "coding-agent",
    "coding-assistant",
    "git",
    "git-diff",
    "jsonrpc",
    "llm",
    "mcp",
    "model-context-protocol",
    "multi-agent",
    "observability",
    "openai",
    "orchestration",
    "remote",
    "repl",
    "scripting",
    "sdk",
    "subagent",
    "telemetry",
    "terminal",
    "terminal-ui",
    "tracing",
    "tui",
    "typescript",
    "websocket",
    "workflow",
    "yukino",
    "yukino.js"
  ],
  "homepage": "https://hangtiancheng.github.io/yukino-code",
  "bugs": {
    "url": "https://github.com/hangtiancheng/yukino-code/issues"
  },
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "repository": {
    "type": "git",
    "url": "https://github.com/hangtiancheng/yukino-code.git",
    "directory": "packages/yukino"
  },
  "bin": {
    "yukino": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./sdk": {
      "types": "./dist/lib/sdk.d.ts",
      "import": "./dist/lib/sdk.js",
      "default": "./dist/lib/sdk.js"
    },
    "./rpc": {
      "types": "./dist/lib/rpc.d.ts",
      "import": "./dist/lib/rpc.js",
      "default": "./dist/lib/rpc.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:browser": "cd src/remote/browser && tsup --watch",
    "build:browser": "cd src/remote/browser && rm -rf ./dist && tsup",
    "preview:browser": "pnpm dlx serve src/remote/browser/dist",
    "dev": "pnpm build:browser && tsx ./src/cli.ts",
    "build": "pnpm build:browser && rm -rf ./dist && tsup",
    "lint": "eslint --cache --quiet ./src ./tests",
    "lint:fix": "eslint --cache --fix --quiet ./src ./tests",
    "test": "vitest run --maxWorkers=2",
    "test:coverage": "vitest run --maxWorkers=2 --coverage",
    "test:watch": "vitest --maxWorkers=2",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/remote/browser/tsconfig.json",
    "format": "prettier -w ./ --experimental-cli",
    "happy": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "happy:fix": "pnpm typecheck && pnpm format && pnpm lint:fix && pnpm build && pnpm test",
    "happy:watch": "pnpm typecheck && pnpm format && pnpm lint:fix && pnpm build && pnpm test:watch",
    "prepublishOnly": "pnpm build",
    "add:user": "pnpm adduser --registry=https://registry.npmjs.org/",
    "tarball": "pnpm build && tarball=$(npm pack --silent) && npm install -g \"./$tarball\" --registry=https://registry.npmjs.org/ --allow-scripts=protobufjs && rm -f \"./$tarball\"",
    "publish:latest": "pnpm publish --access public --registry=https://registry.npmjs.org/",
    "publish:canary": "pnpm publish --access public --registry=https://registry.npmjs.org/ --tag canary"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@anthropic-ai/sandbox-runtime": "^0.0.83",
    "@anthropic-ai/sdk": "^0.104.2",
    "@base-ui/react": "^1.9.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vscode/ripgrep": "^1.18.0",
    "acorn": "^8.19.0",
    "ajv": "^8.20.0",
    "ansi-escapes": "^7.3.0",
    "ansi-regex": "^6.6.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "0.6.5",
    "clsx": "^2.1.1",
    "commander": "^15.1.0",
    "diff": "^9.0.0",
    "dompurify": "^3.5.0",
    "execa": "^10.2.1",
    "express": "^5.3.0",
    "file-type": "^22.3.0",
    "fuse.js": "^7.5.0",
    "glob": "^13.0.7",
    "ink": "^7.1.1",
    "jimp": "^1.7.0",
    "js-yaml": "^4.3.2",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.81.0",
    "marked": "^18.3.0",
    "marked-terminal": "^8.0.1",
    "minimatch": "^10.2.6",
    "openai": "^6.49.0",
    "p-queue": "^10.0.0",
    "partysocket": "^1.3.0",
    "pino": "^10.4.0",
    "quickjs-wasi": "3.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "safe-stable-stringify": "3.0.1",
    "semver": "^7.8.6",
    "shell-quote": "^1.12.0",
    "shiki": "^4.6.0",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "supports-hyperlinks": "5.0.0",
    "tailwind-merge": "^3.7.1",
    "turndown": "^7.2.5",
    "undici": "^8.13.1",
    "use-stick-to-bottom": "1.1.6",
    "wrap-ansi": "^10.0.2",
    "write-file-atomic": "^7.0.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "^0.223.2",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.223.2",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.2",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.223.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.2",
    "@opentelemetry/exporter-prometheus": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@sentry/node": "^10.78.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
