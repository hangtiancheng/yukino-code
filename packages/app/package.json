{
  "name": "@yukino.js/app",
  "version": "0.0.1",
  "description": "Yukino desktop agent workspace with live code editing",
  "main": "./out/main/index.js",
  "author": "github.com/hangtiancheng",
  "homepage": "https://hangtiancheng.github.io/yukino-code",
  "scripts": {
    "format": "prettier -w . --experimental-cli",
    "lint": "eslint --cache . --quiet",
    "lint:fix": "eslint --cache . --fix --quiet",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tests/tsconfig.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:test",
    "happy": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "start": "electron-vite preview",
    "dev": "pnpm --filter '@yukino.js/app^...' --if-present build && electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "happy:fix": "pnpm typecheck && pnpm format && pnpm lint:fix && pnpm build && pnpm test",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:electron": "tsx tests/electron-smoke.ts && tsx tests/electron-agent-smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@streamdown/code": "2.0.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-virtual": "3.14.21",
    "@yukino.js/yukino": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.81.0",
    "monaco-editor": "0.57.0",
    "pino": "^10.4.0",
    "react-resizable-panels": "^4.24.3",
    "shadcn": "^4.23.1",
    "sonner": "^2.0.8",
    "streamdown": "2.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^44.11.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
