{
  "name": "@yukino.js/pkg-build",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "description": "Shared tsdown build configuration for @yukino.js/* workspace packages",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  }
}
