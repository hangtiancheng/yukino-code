{
  "name": "@yukino.js/mcp",
  "version": "0.0.1",
  "description": "Yukino official MCP tools collection",
  "keywords": [
    "MCP",
    "RAG",
    "Yukino",
    "embedding"
  ],
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "bin": {
    "yukino-mcp": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm build:app && tsx ./src/main.ts",
    "build": "tsup && vite build",
    "build:app": "vite build",
    "lint": "eslint --cache --quiet ./src ./tests",
    "lint:fix": "eslint --cache --fix --quiet ./src ./tests",
    "test": "pnpm build:app && vitest run",
    "test:watch": "pnpm build:app && vitest",
    "format": "prettier -w ./ --experimental-cli",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "happy": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "happy:fix": "pnpm typecheck && pnpm lint:fix && pnpm format && pnpm build && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.74",
    "@langchain/core": "^1.2.19",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@platformatic/kafka": "^2.14.0",
    "ai": "^7.0.146",
    "h3": "^2.0.5",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "daisyui": "^5.7.50",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.6.0"
  }
}
