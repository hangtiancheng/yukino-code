    "@langchain/core": "^1.2.13",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ai": "^7.0.118",
    "h3": "2.0.1-rc.32",
    "pino": "^10.3.1",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.46",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
