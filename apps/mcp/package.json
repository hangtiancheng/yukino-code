{
  "name": "@yukino.js/mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Yukino official MCP tools collection",
  "keywords": [
    "MCP",
    "RAG",
    "Yukino",
    "embedding"
  ],
  "license": "MIT",
