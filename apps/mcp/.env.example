# OpenAI-compatible embedding provider (e.g. Alibaba DashScope).
# All three values are required for the docs tool to be functional;
# EMBEDDING_API_KEY falls back to OPENAI_API_KEY when unset.
# EMBEDDING_PROTOCOL is optional and defaults to "openai" (the only supported value for now).
# EMBEDDING_PROTOCOL="openai"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_API_KEY="<your-api-key>"
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# Redis Stack (requires the RediSearch module for vector search).
REDIS_URL="redis://localhost:6379"
REDIS_INDEX_NAME="idx:yukino"
REDIS_KEY_PREFIX="yukino:"

# Knowledge base directory scanned at startup (default: ~/.yukino/docs).
# YUKINO_DOCS_DIR="/absolute/path/to/docs"

# HTTP transport bind address/port, only used with --http / MCP_TRANSPORT=http.
# Endpoints are unauthenticated: keep HOST on localhost unless the network is trusted.
# HOST=127.0.0.1
# PORT=3300
