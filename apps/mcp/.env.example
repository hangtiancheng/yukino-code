# OpenAI-compatible embedding provider.
# All three values are required for docs_tool to be functional;
# EMBEDDING_API_KEY falls back to OPENAI_API_KEY when unset.
# EMBEDDING_PROTOCOL is optional and defaults to "openai" (the only supported value).
# EMBEDDING_PROTOCOL="openai"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_API_KEY="<your-api-key>"
EMBEDDING_BASE_URL="https://cn-beijing.maas.aliyuncs.com/compatible-mode/v1"

# The docs vector index is a local SQLite file, so no external service is
# needed. REDIS_URL is used only by the unrestricted redis_tool below.
REDIS_URL="redis://localhost:6379"

# Unrestricted database tools. Every tool also accepts a per-call connection_url.
# postgres_tool accepts POSTGRESQL_URL or DATABASE_URL as fallbacks.
# POSTGRES_URL="postgresql://user:password@localhost:5432/database"
# MYSQL_URL="mysql://user:password@localhost:3306/database"
# MONGODB_URL="mongodb://user:password@localhost:27017/database?authSource=admin"
# MONGODB_DATABASE="database"

# prometheus_tool: any query, alert, metadata or administrative HTTP endpoint.
# PROMETHEUS_URL is a fallback for PROMETHEUS_BASE_URL.
# PROMETHEUS_BASE_URL="http://localhost:9090"
# PROMETHEUS_TOKEN="<bearer token>"
# Or basic authentication when no bearer token is configured:
# PROMETHEUS_USERNAME="user"
# PROMETHEUS_PASSWORD="password"

# Knowledge base directory synced into the vector index (default: ~/.yukino/docs).
# YUKINO_DOCS_DIR="/absolute/path/to/docs"
# SQLite file holding the index (default: ~/.yukino/index.sqlite). It is a
# rebuildable cache: delete it to force a full re-embed on the next sync.
# YUKINO_INDEX_DB="/absolute/path/to/index.sqlite"

# github_tool requires GitHub CLI (gh) on PATH. Authenticate with gh auth login,
# or configure GH_TOKEN/GITHUB_TOKEN. Any gh subcommand is supported.
# GITHUB_TOKEN="<personal access token>"
# For Enterprise, gh also accepts GH_ENTERPRISE_TOKEN/GITHUB_ENTERPRISE_TOKEN.
# GH_HOST="ghe.example.com"
# Legacy GITHUB_BASE_URL contributes its hostname when GH_HOST is unset.
# GITHUB_BASE_URL="https://ghe.example.com/api/v3"

# HTTP transport bind address/port, only used with --http / MCP_TRANSPORT=http.
# Endpoints are unauthenticated: keep HOST on localhost unless the network is trusted.
# HOST=127.0.0.1
# PORT=3300
