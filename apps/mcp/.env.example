EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_API_KEY="<your-api-key>"
EMBEDDING_BASE_URL="https://cn-beijing.maas.aliyuncs.com/compatible-mode/v1"

REDIS_URL="redis://localhost:6379"

# --- Optional backend tools (uncomment and match your docker-compose ports) ---

# PostgreSQL / MySQL / MongoDB
#POSTGRES_URL="postgresql://yukino:***@localhost:5432/yukino_agent"
#MYSQL_URL="mysql://user:***@localhost:3306/db0"
#MONGODB_URL="mongodb://root:***@localhost:27017/db0?authSource=admin"
#MONGODB_DATABASE="db0"

# Prometheus
#PROMETHEUS_BASE_URL="http://localhost:9090"
#PROMETHEUS_TOKEN=""
#PROMETHEUS_USERNAME=""
#PROMETHEUS_PASSWORD=""

# Grafana (bearer = service-account token / API key, or basic auth)
#GRAFANA_BASE_URL="http://localhost:3000"
#GRAFANA_TOKEN=""
#GRAFANA_API_KEY=""
#GRAFANA_USERNAME="root"
#GRAFANA_PASSWORD=""

# MinIO / S3 (path-style). Falls back to AWS_* variables.
#MINIO_URL="http://localhost:9000"
#MINIO_ACCESS_KEY="admin"
#MINIO_SECRET_KEY="***"
#MINIO_REGION="us-east-1"
#MINIO_SESSION_TOKEN=""

# ClickHouse HTTP interface
#CLICKHOUSE_URL="http://localhost:8123"
#CLICKHOUSE_USER="langfuse"
#CLICKHOUSE_PASSWORD=""
#CLICKHOUSE_DATABASE="default"

# etcd v3 JSON gateway (note: the compose service does not publish 2379 to the host)
#ETCD_URL="http://localhost:2379"

# Milvus RESTful API v2 (shares the gRPC port). Token or username:password.
#MILVUS_URL="http://localhost:19530"
#MILVUS_TOKEN=""
#MILVUS_USERNAME=""
#MILVUS_PASSWORD=""
#MILVUS_DATABASE="default"

# Kafka (@platformatic/kafka; per-call config uses camelCase options and nested tls/sasl)
#KAFKA_BROKERS="localhost:9092"
#KAFKA_CLIENT_ID="yukino-mcp"
#KAFKA_SECURITY_PROTOCOL=""
#KAFKA_SASL_MECHANISM=""
#KAFKA_USERNAME=""
#KAFKA_PASSWORD=""
