            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema0"
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/definitions/__schema0"
              }
            }
          ]
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  "github_tool": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "args": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered gh arguments without the executable name. Each element is one argument, sent verbatim without shell parsing."
        },
        "cwd": {
          "description": "Working directory; defaults to the MCP process directory.",
          "type": "string",
          "minLength": 1
        },
        "stdin": {
          "description": "Text sent verbatim to stdin, e.g. a JSON body for gh api --input -.",
          "type": "string"
        },
        "timeout_ms": {
          "default": 60000,
          "description": "Subprocess timeout in milliseconds; increase for long-running commands.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "response_format": {
          "default": "text",
          "description": "Encoding of stdout; base64 preserves binary API downloads.",
          "type": "string",
          "enum": [
            "text",
            "base64"
          ]
        }
      },
      "required": [
        "args"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
