            "GET",
            "PUT",
            "POST",
            "DELETE",
            "HEAD",
            "PATCH"
          ]
        },
        "bucket": {
          "description": "Target bucket. Omit for the service-level ListBuckets call.",
          "type": "string"
        },
        "key": {
          "description": "Object key, including any '/' path segments.",
          "type": "string"
        },
        "query": {
          "default": {},
