{
  "clickhouse_tool": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "connection_url": {
          "description": "Connection URL override; otherwise uses the configured environment variable.",
          "type": "string",
          "minLength": 1
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "description": "SQL statement to execute verbatim."
        },
        "params": {
          "default": {},
          "description": "Parameterized-query values, sent as param_<name> for {name:Type} placeholders.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "settings": {
          "default": {},
          "description": "ClickHouse settings passed as query parameters, e.g. {max_execution_time: 10, readonly: 1}.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "database": {
          "description": "Database override (CLICKHOUSE_DATABASE fallback).",
          "type": "string",
          "minLength": 1
        },
        "format": {
          "description": "default_format for results when the SQL has no FORMAT clause. Defaults to JSON.",
          "type": "string",
          "minLength": 1
        },
        "data": {
          "description": "Raw data body for INSERT ... FORMAT <fmt>; the SQL moves to the query parameter.",
          "type": "string"
        },
        "data_base64": {
          "description": "Base64-encoded data body for binary INSERT formats.",
          "type": "string"
        },
        "user": {
          "description": "User override.",
          "type": "string",
          "minLength": 1
        },
        "password": {
          "description": "Password override.",
          "type": "string"
        },
        "api_key": {
          "description": "Send X-ClickHouse-Key instead of basic auth.",
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "default": {},
          "description": "Additional HTTP headers.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "stacktrace": {
          "default": false,
          "description": "Request a server stack trace on errors.",
          "type": "boolean"
        },
        "timeout_ms": {
          "default": 30000,
          "description": "HTTP request timeout in milliseconds.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sql"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  "create_app": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "html": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000,
          "description": "Complete, self-contained HTML document to render (doctype, styles and scripts inlined). Scripts run in a sandboxed iframe without storage or cookies. External assets may only load from popular CDNs (https://unpkg.com, https://cdn.jsdelivr.net, https://cdn.tailwindcss.com, https://cdnjs.cloudflare.com, https://esm.sh, https://fonts.googleapis.com, https://fonts.gstatic.com). Keep it under 200000 characters."
        },
        "title": {
          "default": "MCP App",
          "description": "Short human-readable label shown above the app.",
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "html"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://create-app/create-app.html"
      },
      "ui/resourceUri": "ui://create-app/create-app.html"
    }
  },
  "docs_sync": {
    "inputSchema": {
      "type": "object",
