  "minio_tool": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "endpoint": {
          "description": "S3 endpoint origin override, e.g. http://localhost:9000.",
          "type": "string",
          "minLength": 1
        },
        "region": {
          "description": "Signing region override (default us-east-1).",
          "type": "string",
          "minLength": 1
        },
        "method": {
          "default": "GET",
