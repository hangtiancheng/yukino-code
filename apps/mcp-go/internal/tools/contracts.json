        "raw_base64": {
          "default": false,
          "description": "Disable automatic base64 encoding/decoding of key/range_end/value fields.",
          "type": "boolean"
        },
        "timeout_ms": {
          "default": 30000,
          "description": "HTTP request timeout in milliseconds.",
          "type": "integer",
          "exclusiveMinimum": 0,
