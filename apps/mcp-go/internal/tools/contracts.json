  "kafka_tool": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "brokers": {
          "description": "CSV broker list override, e.g. localhost:9092.",
          "type": "string",
          "minLength": 1
        },
        "client_id": {
          "description": "Client id override.",
          "type": "string",
          "minLength": 1
        },
        "config": {
          "default": {},
          "description": "Raw librdkafka global configuration passthrough, e.g. {'security.protocol':'SASL_SSL','sasl.mechanisms':'SCRAM-SHA-512'}.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "operation": {
          "type": "string",
          "enum": [
            "produce",
            "consume",
            "list_topics",
            "describe_topics",
            "describe_cluster",
            "create_topic",
            "delete_topic",
            "create_partitions",
            "watermark_offsets",
            "committed_offsets"
          ]
        },
        "topic": {
          "description": "Target topic.",
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "description": "Topics to subscribe for consume.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "messages": {
          "description": "Messages to produce. A null value writes a tombstone.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "partition": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "timestamp": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "assignments": {
          "description": "Explicit partition assignments for consume (bypasses group subscription).",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "partition": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "topic",
              "partition"
            ]
          }
        },
        "partitions": {
          "description": "Partition list for watermark_offsets and committed_offsets.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "partition": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "partition"
            ]
          }
        },
        "group_id": {
          "description": "Consumer group id.",
          "type": "string",
          "minLength": 1
        },
        "from_beginning": {
          "default": false,
          "description": "consume from earliest offset (auto.offset.reset=earliest).",
          "type": "boolean"
        },
        "auto_commit": {
          "default": false,
          "description": "Enable consumer auto-commit.",
          "type": "boolean"
        },
        "max_messages": {
          "default": 50,
          "description": "Maximum messages to collect for consume.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "num_partitions": {
          "description": "Partition count for create_topic / desired total for create_partitions.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "replication_factor": {
          "description": "Replication factor for create_topic.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "topic_config": {
          "description": "Topic-level config entries for create_topic, e.g. {'retention.ms':'86400000'}.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "encoding": {
          "default": "utf8",
          "description": "Encoding for message keys/values.",
          "type": "string",
          "enum": [
            "utf8",
            "base64"
          ]
        },
        "timeout_ms": {
          "default": 15000,
          "description": "Consume window and per-request timeout in milliseconds.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "operation"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
