{
  "extends": "../tsconfig.web.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "../playwright.config.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.d.ts",
    "../src/preload/*.d.ts",
    "../src/shared/**/*",
    "../src/main/**/*",
    "../src/renderer/src/lib/**/*"
  ]
}
