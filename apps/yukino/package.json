{
  "name": "@yukino.js/yukino",
  "version": "0.0.17",
  "description": "Yukino is a terminal-based AI coding agent. It provides an interactive UI (terminal user interface) for conversing with large language models, executing code, manipulating files, and orchestrating multi-agent workflows, all from the command line.",
  "keywords": [
    "a2a",
    "acp",
    "agent",
    "agent-team",
    "ai",
    "anthropic",
    "assistant",
    "automation",
    "chat",
    "chatbot",
    "cli",
    "code-review",
    "coding-agent",
    "coding-assistant",
    "git",
    "git-diff",
    "jsonrpc",
    "llm",
    "mcp",
    "model-context-protocol",
    "multi-agent",
    "observability",
    "openai",
    "orchestration",
    "remote",
    "repl",
    "scripting",
    "sdk",
    "subagent",
    "telemetry",
    "terminal",
    "terminal-ui",
    "tracing",
    "tui",
    "typescript",
    "websocket",
    "workflow",
    "yukino",
    "yukino.js"
  ],
  "homepage": "https://hangtiancheng.github.io/yukino-code",
  "bugs": {
    "url": "https://github.com/hangtiancheng/yukino-code/issues"
  },
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "repository": {
    "type": "git",
    "url": "https://github.com/hangtiancheng/yukino-code.git",
    "directory": "apps/yukino"
  },
  "bin": {
    "yukino": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:browser": "pnpm --filter @yukino.js/browser run dev",
    "build:browser": "pnpm --filter @yukino.js/browser run build",
    "preview:browser": "pnpm dlx serve ../../packages/browser/dist",
    "dev": "pnpm build:browser && tsx ./src/cli.ts",
    "build": "pnpm build:browser && rm -rf ./dist && tsdown",
    "lint": "eslint --cache --quiet ./src ./tests ../../packages",
    "lint:fix": "eslint --cache --fix --quiet ./src ./tests ../../packages",
    "test": "vitest run --maxWorkers=8",
    "test:coverage": "vitest run --maxWorkers=8 --coverage",
    "test:watch": "vitest --maxWorkers=8",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../../packages/browser/tsconfig.json",
    "format": "prettier -w ./ ../../packages --experimental-cli",
    "happy": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "happy:fix": "pnpm typecheck && pnpm format && pnpm lint:fix && pnpm build && pnpm test",
    "happy:watch": "pnpm typecheck && pnpm format && pnpm lint:fix && pnpm build && pnpm test:watch",
    "prepublishOnly": "pnpm build",
    "add:user": "pnpm adduser --registry=https://registry.npmjs.org/",
    "publish:latest": "pnpm publish --access public --registry=https://registry.npmjs.org/",
    "publish:canary": "pnpm publish --access public --registry=https://registry.npmjs.org/ --tag canary"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@agentclientprotocol/sdk": "^1.9.0",
    "@anthropic-ai/sdk": "^0.104.2",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ansi-escapes": "^7.3.0",
    "ansi-regex": "^6.4.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "fuse.js": "^7.5.0",
    "glob": "^13.0.6",
    "ink": "^7.1.1",
    "jimp": "^1.6.1",
    "js-yaml": "^4.3.2",
    "marked": "^18.1.1",
    "minimatch": "^10.2.6",
    "node-emoji": "^2.2.0",
    "openai": "^6.49.0",
    "pino": "^10.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "^4.5.0",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "supports-hyperlinks": "^4.6.0",
    "turndown": "^7.2.4",
    "wrap-ansi": "^10.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@langfuse/otel": "^5.14.0",
    "@langfuse/tracing": "^5.14.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
