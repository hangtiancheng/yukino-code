{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "../..",
    "outDir": "./dist/.dts"
  },
  "include": ["shims.d.ts", "src", "../../packages/*/src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "../../packages/pkg-build/src",
    "../../packages/browser/src"
  ]
}
